# MediSense AI - Backend Environment Configuration
DJANGO_SECRET_KEY=your-production-secret-key-here-min-50-chars
DJANGO_DEBUG=False
ALLOWED_HOSTS=*

# Database (PostgreSQL on Render/Supabase/Neon or SQLite)
DATABASE_URL=postgresql://user:password@host:5432/medisense_db

# Optional AI API Keys (System works 100% free with on-device RapidOCR + CDSCO RAG out of the box)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# File Storage
MAX_UPLOAD_SIZE_MB=15

