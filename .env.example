# MediSense AI - Environment Variables Configuration

# Django Core
DJANGO_SECRET_KEY=change-this-to-a-super-secret-key-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database (Leave USE_POSTGRES=False for instant local SQLite dev mode)
USE_POSTGRES=False
DATABASE_URL=postgres://medisense_user:password@localhost:5432/medisense_db

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI & Document Processing
# Supported providers: gemini, openai, or mock (automatic offline fallback)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# OCR & File Limits
MAX_UPLOAD_SIZE_MB=15

# Celery & Redis (Optional background task queues)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Frontend (for React app)
VITE_API_URL=http://localhost:8000/api

